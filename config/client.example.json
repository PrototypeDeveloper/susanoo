{
  "controller": "192.168.10.1:8443",
  "pki_dir": "/etc/susanoo/client",
  "state_dir": "/var/lib/susanoo/client",
  "heartbeat_interval": "5s",
  "honeytokens": [
    {
      "path": "/home/user/.aws/credentials",
      "kind": "aws"
    },
    {
      "path": "/home/user/.ssh/id_ed25519_backup",
      "kind": "ssh"
    },
    {
      "path": "/home/user/project/.env",
      "kind": "env"
    },
    {
      "path": "/home/user/Documents/パスワード一覧.txt",
      "kind": "text"
    }
  ],
  "nft": "/usr/sbin/nft",
  "process_monitor": true,
  "connection_monitor": true,
  "files": {
    "watch": [
      "/etc/hosts",
      "/etc/ssl/certs",
      "/home/user/.ssh"
    ],
    "persistence": [
      "/etc/cron.d",
      "/etc/systemd/system",
      "/etc/systemd/system/*.wants",
      "/home/user/.config/autostart",
      "/home/user/.bashrc"
    ],
    "privilege": [
      "/etc/passwd",
      "/etc/shadow",
      "/etc/sudoers.d",
      "/etc/pam.d"
    ],
    "sensitive": [
      {"path": "/home/user/.ssh/id_*", "exclude": ["*.pub"], "readers": ["ssh", "ssh-add", "ssh-agent", "ssh-keygen", "scp", "sftp"]},
      {"path": "/home/user/.aws/credentials", "readers": ["aws"]},
      {"path": "/home/user/.mozilla/firefox/*/cookies.sqlite", "readers": ["firefox"]},
      {"path": "/home/user/.mozilla/firefox/*/logins.json", "readers": ["firefox"]}
    ],
    "protect": [
      "/home/user/Documents",
      "/home/user/ドキュメント"
    ],
    "mass_files": 200,
    "mass_window": "30s"
  },
  "kernel_modules": true,
  "logons": {
    "enabled": true,
    "sessions_dir": "/run/systemd/sessions",
    "auth_logs": ["/var/log/auth.log", "/var/log/secure"],
    "journal": true
  },
  "evidence": {
    "logs": ["/var/log/auth.log", "/var/log/syslog", "/var/log/kern.log"]
  },
  "agents": [
    {"name": "claude", "match": ["claude", "@anthropic-ai/claude-code/"]},
    {"name": "codex", "match": ["codex", "@openai/codex/"]}
  ],
  "privilege_separation": true,
  "analyzer_user": "nobody"
}
