{
  "listen": "192.168.10.1:8443",
  "pki_dir": "/etc/susanoo/controller",
  "state_dir": "/var/lib/susanoo/gw",
  "policy": "/etc/susanoo/policy.json",
  "heartbeat_timeout": "30s",
  "nft": "/usr/sbin/nft",
  "router": {
    "lan": "enp2s0",
    "wan": "enp1s0",
    "wan_dhcp": true,
    "admin_ports": [
      22
    ],
    "trusted_routers": [],
    "nd_probe_interval": "5m"
  },
  "dhcp": {
    "range": "192.168.10.100-192.168.10.199",
    "lease_time": "1h"
  },
  "dns": {
    "upstreams": [
      {
        "address": "192.168.0.1:53"
      }
    ],
    "log_queries": true
  },
  "flow_log": true,
  "privilege_separation": true,
  "controller_user": "susanoo-ctl",
  "lan_user": "susanoo-net",
  "notify": {
    "rate_limit": 30,
    "destinations": [
      {
        "name": "chat",
        "type": "slack",
        "url": "https://hooks.slack.com/services/XXXXXXXX/XXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX"
      },
      {
        "name": "admin-mail",
        "type": "email",
        "events": ["isolate", "pending", "alert"],
        "email": {
          "server": "smtp.example.jp:587",
          "tls": "starttls",
          "username": "susanoo@example.jp",
          "password": "change-me",
          "from": "susanoo@example.jp",
          "to": ["admin@example.jp"]
        }
      },
      {
        "name": "soc",
        "type": "webhook",
        "url": "https://soc.example.jp/hooks/susanoo",
        "headers": {"Authorization": "Bearer change-me"},
        "events": ["isolate", "finding"],
        "min_severity": "high"
      }
    ]
  }
}
