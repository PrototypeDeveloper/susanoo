{
  "version": 1,
  "name": "標準（学習モード）",
  "issued_at": "2026-10-18T00:00:00Z",
  "response": "monitor",
  "on_failure": "fail_open",
  "groups": [
    {
      "name": "default",
      "egress": {
        "default": "learn",
        "learn_period": "336h",
        "deny": [
          { "cidr": "203.0.113.0/24" },
          { "domain": "*.example.net" }
        ]
      },
      "isolation": "management_and_updates",
      "updates": [
        { "domain": "*.ubuntu.com", "ports": [80, 443], "protocol": "tcp" }
      ],
      "apps": {
        "mode": "monitor",
        "default": "allow",
        "rules": [
          {
            "name": "AI エージェントは使うサービスの API だけ",
            "agents": ["claude"],
            "dst": [{ "domain": "api.anthropic.com", "ports": [443], "protocol": "tcp" }],
            "action": "allow"
          },
          {
            "name": "AI エージェントのほかの通信",
            "agents": ["*"],
            "action": "deny"
          },
          {
            "name": "ファイルの転送の道具は社内だけ",
            "names": ["rclone", "scp", "sftp", "ftp"],
            "dst": [{ "cidr": "192.168.10.0/24" }],
            "action": "allow"
          },
          {
            "name": "ファイルの転送の道具のほかの通信",
            "names": ["rclone", "scp", "sftp", "ftp"],
            "action": "deny"
          }
        ]
      }
    },
    {
      "name": "server",
      "egress": {
        "default": "deny",
        "allow": [
          { "domain": "*.ubuntu.com", "ports": [80, 443], "protocol": "tcp" },
          { "cidr": "192.0.2.0/24", "ports": [123], "protocol": "udp" }
        ]
      },
      "isolation": "management",
      "require_approval": true
    }
  ]
}
